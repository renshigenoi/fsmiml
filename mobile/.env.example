# Base URL server FSM (Laravel). Di dalam APK, origin adalah lokal (capacitor://localhost),
# jadi panggilan API TIDAK boleh memakai path relatif — harus absolut ke server ini.
#
# Development (Laragon di PC yang sama, diakses dari HP/emulator):
#   - Emulator Android: gunakan http://10.0.2.2:8000  (10.0.2.2 = localhost host dari emulator)
#   - HP fisik satu WiFi:  gunakan http://<IP-LAN-PC>:8000  (mis. http://192.168.1.10:8000)
#
# Production:
#   VITE_API_BASE=https://fsm.subdomain.com
VITE_API_BASE=http://10.0.2.2:8000
