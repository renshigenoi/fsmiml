# ------------------------------------------------------------
# Mobile APK (NATIVE — wajib install ulang APK)
# ------------------------------------------------------------
# Naikkan MOBILE_APP_VERSION setiap kali ada perubahan native (Java/Kotlin/plugin Capacitor).
# APK Release disimpan di: public/downloads/apk/fsm-teknisi-{versi}.apk
# Setelah update .env VPS, jalankan: php artisan config:clear
MOBILE_APP_VERSION=1.1.4
MOBILE_APP_DOWNLOAD_URL=https://fsm.indomotorlestari.com/downloads/apk/fsm-teknisi-1.1.4.apk
